# ==============================================================
# LeetCode Credentials
# ==============================================================
# 1. Log in to https://leetcode.com in your web browser (Chrome/Edge/Brave).
# 2. Open Chrome DevTools (F12 or Cmd+Option+I) -> Application -> Cookies -> https://leetcode.com
# 3. Copy the values for 'LEETCODE_SESSION' and 'csrftoken'.
LEETCODE_SESSION=your_leetcode_session_cookie_here
LEETCODE_CSRF_TOKEN=your_leetcode_csrf_token_here
LEETCODE_USERNAME=your_leetcode_username_here

# ==============================================================
# Gemini LLM Credentials
# ==============================================================
# Get your Gemini API Key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ==============================================================
# Pipeline & Anti-Ban Guardrails Configuration
# ==============================================================
# Minimum and maximum jitter cooldown between LeetCode solution publications (in seconds)
LC_PUBLISH_DELAY_MIN=75
LC_PUBLISH_DELAY_MAX=120

# Repository & Remote Sync Settings
GITHUB_REPO_DIR=.
STATE_FILE=./state.json
# Optional: Set your remote repository URL (e.g., https://github.com/username/leetcode-solutions.git)
GITHUB_REMOTE_URL=
# Automatically push commits to remote origin main (true/false)
GITHUB_AUTO_PUSH=false

# Webhook server settings (for Chrome extension integration)
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8765
