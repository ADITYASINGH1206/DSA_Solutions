{
  "manifest_version": 3,
  "name": "LeetCode to Community & GitHub Pipeline Trigger",
  "version": "1.0.0",
  "description": "Automatically triggers local LLM editorial generation, LeetCode Community publishing, and GitHub repository synchronization upon Accepted C++ submissions.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LeetCode Pipeline Trigger"
  }
}
